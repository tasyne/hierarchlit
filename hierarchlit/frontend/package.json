{
  "name": "hierarchlit-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run typecheck && vite build && npm run check:bundle",
    "check:bundle": "node scripts/check-browser-bundle.mjs",
    "clean": "rimraf build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@streamlit/component-v2-lib": "^0.2.0",
    "@tanstack/react-virtual": "^3.13.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.1.1"
  }
}
